# ==============================================================================
# PACTA ESCROW PROTOCOL — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env and configure secrets in your KMS / Vault / environment
# ==============================================================================

# Network & RPC
PACTA_NETWORK=base
PACTA_RPC_URL=https://mainnet.base.org

# Smart Contract Addresses (Base L2)
PACTA_VAULT_ADDRESS=0xPactaSmartVaultBaseL2_2026
PACTA_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PACTA_TREASURY_ADDRESS=0xPactaProtocolTreasury_BaseL2
PACTA_ARBITRATOR_ORACLE=0xPactaArbitrationOracle_BaseL2

# Protocol Parameters
PACTA_DEFAULT_TIMEOUT_MS=5000
PACTA_PROTOCOL_FEE_BPS=75
PACTA_DISPUTE_BOND_BPS=2000

# Service & Server
PACTA_HOST=0.0.0.0
PACTA_PORT=8090
PACTA_LOG_LEVEL=INFO
